diff --git a/bindings/setup.py b/bindings/setup.py
index 5f650752..970a9205 100644
--- a/bindings/setup.py
+++ b/bindings/setup.py
@@ -2,8 +2,32 @@
 
 import distutils.command.build
 from distutils.core import setup, Extension
+# ─── LOCAL MODIFICATION -- INTENTIONAL, DO NOT REVERT ────────────────────────
+# Links the out-of-tree thesis controller into the SIL bindings so the simulator runs the same
+# Rust source that flies. Additive only; a checkout without that controller still builds.
+# This tree tracks bitcraze upstream and is deliberately NOT forked, so these lines stay
+# uncommitted by design. Patch copy and rationale:
+#   flying_drone_stack/firmware_app/host/cffirmware_bindings.patch
+#   flying_drone_stack/firmware_app/host/LOCAL_MODIFICATIONS.md
 import os
 
+# ── Out-of-tree controller (optional) ────────────────────────────────────────
+# When the flying_drone_stack firmware_app has been built for the host, link it in
+# so the SAME geometric/INDI controller that flies on the drone can be exercised in
+# simulation. Not a reimplementation -- the identical Rust source, compiled for
+# x86_64. Build it with:
+#   cd firmware_app && RUSTFLAGS="-C panic=abort" \
+#       cargo build --release --target x86_64-unknown-linux-gnu
+# If the archive is absent the bindings build exactly as before, so this stays
+# optional and nothing breaks for anyone without that repo.
+# [simulator package] OOT_DIR is the directory with the host C files (oot_host.c, traj_iface.c, ns2_weights.c, rpm_filter.h, rust_stubs.c);
+# build_bindings.sh sets OOT_FIRMWARE_APP to simulator/firmware/host. OOT_WITH_RUST=1 additionally links the Rust static library
+# libcf_controller_rs.a (path in OOT_RUST_LIB); default 0 = the cf_rnn_* symbols come from rust_stubs.c.
+OOT_DIR = os.environ.get("OOT_FIRMWARE_APP", "")
+OOT_WITH_RUST = os.environ.get("OOT_WITH_RUST", "0") == "1"
+OOT_LIB = os.environ.get("OOT_RUST_LIB", "")
+OOT_AVAILABLE = bool(OOT_DIR) and os.path.isdir(OOT_DIR) and (not OOT_WITH_RUST or os.path.isfile(OOT_LIB))
+
 include = [
     "src/modules/interface",
     "src/modules/interface/controller",
@@ -42,6 +66,14 @@ fw_sources = [
     "src/modules/src/controller/controller_mellinger.c",
     "src/modules/src/controller/controller_brescianini.c",
     "src/modules/src/controller/controller_lee.c",
+    "src/modules/src/controller/controller_indi.c",
+    "src/modules/src/controller/position_controller_indi.c",
+    "src/modules/src/controller/controller_omar_indi.c",
+    "src/modules/src/controller/controller_tk_indi.c",
+    "src/modules/src/ns2_residual.c",   # NS2 in C for the Omar tree (weak links to the app symbols)
+    "src/modules/src/fbl_residual.c",   # learned-FBL downwash residual (authors' ROM evaluated exactly) and law, Strategy 3
+    "src/modules/src/fbl_law.c",
+    "src/modules/src/fbl_nn_weights.c",   # trained force network of the FBL residual (export_fbl_nn_weights.py)
     "src/utils/src/pid.c",
     "src/utils/src/filter.c",
     "src/utils/src/num.c",
@@ -57,17 +89,61 @@ fw_sources = [
     "src/modules/src/kalman_core/mm_distance.c",
 ]
 
+oot_sources, oot_objects, oot_defines = [], [], []
+if OOT_AVAILABLE:
+    oot_sources = [
+        os.path.join(OOT_DIR, "traj_iface.c"),   # gains/globals, single source of truth
+        os.path.join(OOT_DIR, "oot_host.c"),     # RPM injection + log sinks
+        os.path.join(OOT_DIR, "ns2_weights.c"),  # flash weights of the C NS2 (generated from ns2_v2.npz)
+    ]
+    if OOT_WITH_RUST: oot_objects = [OOT_LIB]
+    else: oot_sources.append(os.path.join(OOT_DIR, "rust_stubs.c"))      # the simulator never calls the Rust controllers
+    # traj_iface.c's rpm_get_all reads the RPM deck through the firmware log system,
+    # which does not exist here; rename it so host/oot_host.c can provide one the
+    # simulator feeds with true motor speeds.
+    # traj_iface.c's RPM reader and log sinks target the firmware's log system, which
+    # does not exist here. Rename them all out of the way; host/oot_host.c provides
+    # replacements the simulator can drive and read.
+    oot_defines = ["-D%s=%s_fw_unused" % (n, n) for n in (
+        "rpm_get_all", "indi_log_write", "indi_tau_write",
+        "indi_notch_log_write", "indi_a_res_write", "indi_e_r_write",
+        "oot5_diag_write", "peer_get_all")]
+    print("[setup] out-of-tree host layer from", OOT_DIR, "with Rust library" if OOT_WITH_RUST else "without Rust library")
+else:
+    print("[setup] out-of-tree controller: not built, skipping (sim will lack 'oot')")
+
 cffirmware = Extension(
     "_cffirmware",
-    include_dirs=include,
-    sources=fw_sources + ["build/cffirmware_wrap.c"],
+    include_dirs=include + ([OOT_DIR] if OOT_AVAILABLE else []),
+    sources=fw_sources + oot_sources + ["build/cffirmware_wrap.c"],
+    extra_objects=oot_objects,
     extra_compile_args=[
         "-O3",
         # The following flags are also used for compiling the actual firmware
         "-fno-strict-aliasing",
         "-Wno-address-of-packed-member",
         "-DUNIT_TEST_MODE",
-    ],
+        # Which airframe the firmware believes it is flying. Without this the
+        # bindings fall back to the generic defaults (THRUST_MAX 0.1125 N/motor,
+        # ARM_LENGTH 0.046 m) -- a smaller motor than our thesis drone actually has.
+        # powerDistribution then maps a legitimate force command to a PWM above
+        # UINT16_MAX, the mixer saturates, and controllers that command large
+        # torques (attitude INDI) get three motors cut to zero and never lift off.
+        # This is the same failure that was traced on the upgraded CF2.1 hardware.
+        # Override with OOT_PLATFORM=CONFIG_PLATFORM_CF2 for the brushed drone.
+        "-D" + os.environ.get("OOT_PLATFORM", "CONFIG_PLATFORM_CF21BL"),
+        # 2026-09-23: CF_MASS override, mirrors firmware_app/app-config-bl's
+        # CONFIG_MODIFIED_CF_MASS -- but the embedded build's Kconfig .config and THIS host
+        # build's .config are two entirely separate files (confirmed directly: the embedded
+        # build's app-config-bl override never reached this .config, which still reported
+        # "CONFIG_MODIFY_CF_MASS is not set"). Without this define, every host/SIL test of
+        # controller=9 (and anything else reading CF_MASS) silently used the stock 39.3g
+        # default, not the 42.7g actually flashed to hardware -- a real config-drift risk
+        # between what's tested and what flies. 42700 = Omar's own brushless-established mass
+        # (crazyflie-firmware-omar/configs/cf21blrpm_defconfig), matching app-config-bl.
+        # If app-config-bl's CONFIG_MODIFIED_CF_MASS is ever changed, update this too.
+        "-DCONFIG_MODIFIED_CF_MASS=" + os.environ.get("OOT_CF_MASS_UG", "42700"),
+    ] + oot_defines,
 )
 
 # Override build command to specify custom "build" directory
