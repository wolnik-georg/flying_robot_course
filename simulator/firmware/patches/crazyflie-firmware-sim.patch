diff --git a/src/modules/interface/fbl_law.h b/src/modules/interface/fbl_law.h
new file mode 100644
index 00000000..15f49bfb
--- /dev/null
+++ b/src/modules/interface/fbl_law.h
@@ -0,0 +1,61 @@
+/*
+ * Learned-FBL control law (paper Eqs. 15, 10, 19, 17-18), C implementation for the Omar C controller tree. STAGE 3 PREPARATION: lives under
+ * experiments/fbl/stage3_port/c/, NOT in the firmware tree. Port of the authors' `compute_fbl_command` and of `FBLControl._position_commands`
+ * (position PID with integral, alpha-beta-gamma acceleration estimate, acceleration and jerk commands). Specification: docs/fbl/PORT_SPEC.md.
+ *
+ * Frames: R maps body vectors to world (row-major, R[3*i + j]); linear quantities in the world frame; body rates and torques in the body frame.
+ * The thrust is projected on the MEASURED body z axis (Sec. 3.3, footnote 2). The 0.01 N floor protects only the rate inversion.
+ * Residual inputs are the outputs of fbl_residual.c (acceleration and jerk of the downwash; the angular acceleration residual is computed there and logged, the controller passes zero here: stock rate PID).
+ */
+#ifndef FBL_LAW_H
+#define FBL_LAW_H
+
+#include <stdint.h>
+
+typedef struct {
+  float pos_kp[3];   /* position gains (acceleration per m)        bundle: 56, 56, 45 */
+  float vel_kp[3];   /* velocity gains                              38, 38, 21.6 */
+  float int_kp[3];   /* integral gains                              48, 48, 3 */
+  float rate_k[3];   /* body-rate gains (acceleration gains, torque gain = J K)  238, 238, 140 */
+  float inertia[3];  /* diagonal inertia kg m^2 */
+  float mass;        /* kg */
+  float gravity;     /* m/s^2 */
+  float abg_beta;    /* alpha-beta-gamma: velocity correction gain   0.4 */
+  float abg_gamma;   /* acceleration correction gain                 0.1 */
+} fbl_gains_t;
+
+typedef struct {
+  float int_err[3];  /* integral of the position error */
+  float vel_est[3];  /* estimator velocity */
+  float acc_est[3];  /* estimator acceleration */
+  float prev_t;      /* estimator: time of the previous accepted update [s] */
+  float int_t;       /* integral: time of the previous call [s] */
+  uint8_t init;      /* 0 until the first update */
+} fbl_law_state_t;
+
+/* flat output / reference: position, velocity, acceleration, jerk (world frame) */
+typedef struct { float x[3], x_dot[3], x_ddot[3], x_dddot[3]; } fbl_ref_t;
+
+void fbl_gains_default_bundle(fbl_gains_t *g);          /* the bundle's gains with mass and inertia of the 30 g simulation vehicle (change them for ours) */
+void fbl_law_reset(fbl_law_state_t *s);
+
+/* Eqs. 17-18: acceleration and jerk command from the state, the reference and the acceleration estimate (updates the state). t in seconds. */
+void fbl_law_position(fbl_law_state_t *s, const fbl_gains_t *g, float t, const float pos[3], const float vel[3], const fbl_ref_t *ref,
+                      float acc_cmd[3], float jerk_cmd[3]);
+
+/* Same with the update interval given directly (the real elapsed time of the controller tick, from the firmware microsecond timestamp; avoids absolute time
+   in float on the drone). Estimator and integral use the same dt, as the bundle's t - prev_t. The first call only initialises. */
+void fbl_law_position_dt(fbl_law_state_t *s, const fbl_gains_t *g, float dt, const float pos[3], const float vel[3], const fbl_ref_t *ref,
+                         float acc_cmd[3], float jerk_cmd[3]);
+
+/* Same with separate intervals for the alpha-beta-gamma estimator (dt_est; 0 = no new velocity sample, estimate held) and the integral (dt_int).
+   With dt_est = time since the last new velocity this is the bundle's estimator driven at the measurement rate. The first call only initialises. */
+void fbl_law_position_dt2(fbl_law_state_t *s, const fbl_gains_t *g, float dt_est, float dt_int, const float pos[3], const float vel[3], const fbl_ref_t *ref,
+                          float acc_cmd[3], float jerk_cmd[3]);
+
+/* Eqs. 15, 10, 19: thrust [N], desired body rates [rad/s], body torque [N m]. Stateless. */
+void fbl_law_command(const float R[9], const float w[3], const float acc_cmd[3], const float jerk_cmd[3], float yaw, float yaw_rate,
+                     const float res_acc[3], const float res_jerk[3], const float res_ang_acc[3], const fbl_gains_t *g,
+                     float *thrust, float w_des[3], float torque[3]);
+
+#endif
diff --git a/src/modules/interface/fbl_residual.h b/src/modules/interface/fbl_residual.h
new file mode 100644
index 00000000..d795abb7
--- /dev/null
+++ b/src/modules/interface/fbl_residual.h
@@ -0,0 +1,82 @@
+/*
+ * Learned-FBL downwash residual, C implementation for the Omar C controller tree. Authors-aligned version (2026-11-04): the residual is the authors' own
+ * DownwashResidual evaluated in float32 on the drone, nothing else:
+ *   - ROM force and its partials: downwash_force_and_derivs_fo (closed-form jet profile on a 10 x 10 trapezoid grid, evaluated exactly, no table),
+ *   - ROM torque: downwash_torque_fo, converted to a body angular acceleration with our inertia (computed and logged, NOT applied: stock rate PID),
+ *   - force network (Linear(2, nh) -> tanh -> Linear(nh, 3) on (r0, z0)) with the analytic time derivative of the flow frame; no torque network (we have none),
+ *   - geometry as point_line_distance with the neighbour treated as upright: r0 = horizontal distance, z0 = |height difference| (so a neighbour BELOW acts
+ *     too), and NO gate: every neighbour contributes at any distance, the residuals of all neighbours are summed (_predict_residual), the yaw component of the
+ *     angular acceleration is zeroed.
+ * Which drone uses the residual is a per-drone switch outside this module (ctrlFbl.dw_en), like the authors' downwash / use_NN flags.
+ * Our numbers (parameters, not code): mass, C_D, inertia (arguments), propeller radius (the bundle's constants), arm length (FBL_ROM_ARM_LENGTH), network weights.
+ * No dynamic memory, no globals, only sqrtf / tanhf. Specification: docs/fbl/PORT_SPEC.md.
+ */
+#ifndef FBL_RESIDUAL_H
+#define FBL_RESIDUAL_H
+
+#include <stdint.h>
+
+#define FBL_MAX_NEIGHBOURS 3
+#ifndef FBL_ROM_ARM_LENGTH
+#define FBL_ROM_ARM_LENGTH 0.050f   /* m, our airframe (ARM_LENGTH of platform_defaults_cf21bl.h); the authors' simulated vehicle: 0.046 */
+#endif
+
+typedef struct {
+  float acc[3];      /* world frame, m/s^2 */
+  float jerk[3];     /* world frame, m/s^3 */
+  float ang_acc[3];  /* body frame, rad/s^2: ROM torque / inertia, yaw component zero (logged, not applied) */
+  uint8_t n_active;  /* neighbours that contributed */
+} fbl_res_t;
+
+typedef struct {
+  float x, y, z;
+  uint32_t ts;
+} fbl_peer_prev_t;
+
+typedef struct {
+  fbl_peer_prev_t prev[FBL_MAX_NEIGHBOURS]; /* previous peer sample (position, timestamp ms) */
+  float vel[FBL_MAX_NEIGHBOURS][3];         /* last peer velocity estimate */
+} fbl_state_t;
+
+/* Learned force correction of the paper's hardware recipe (ROM + small force network, Sec. 5.2): net_f = Linear(2, nh) -> tanh -> Linear(nh, 3) on (r0, z0),
+   output = local acceleration in the flow frame (x radial toward the neighbour, z = +world z), rotated to the world; jerk = analytic time derivative
+   (network Jacobian along (dr0/dt, dz0/dt) + rotation of the frame), as the bundle's DownwashResidual._acceleration_nn_analytical_jvp. */
+#define FBL_NN_HMAX 16
+typedef struct {
+  uint8_t nh;                    /* hidden neurons (paper hardware: 4; bundle sample: 9); 0 = no network */
+  float w1[FBL_NN_HMAX][2], b1[FBL_NN_HMAX];
+  float w2[3][FBL_NN_HMAX], b2[3];
+} fbl_nn_t;
+
+/* Weights from a generated file (fbl_nn_weights.c, exported from a trained ODEFunc); weak: absent = no network, the residual stays ROM only. */
+extern const fbl_nn_t fbl_nn_weights __attribute__((weak));
+
+/* Network for the residual: NULL (default) = ROM only. */
+void fbl_residual_set_nn(const fbl_nn_t *nn);
+
+/* One neighbour, network term only (for tests against the bundle). Adds to acc / jerk. */
+void fbl_nn_pair(const fbl_nn_t *nn, const float p[3], const float v[3], const float p_top[3], const float v_top[3], float acc[3], float jerk[3]);
+
+/* The authors' ROM force (downwash_force_and_derivs_fo) in float32: F [N] and dF/dz0, dF/dr0 [N/m] for an upper vehicle of mass `mass` [kg] at axial
+   distance z0 and radial distance r0 [m], drag coefficient c_d, S = 0.0997. The mass enters only through the jet velocity (it cancels in F / mass). */
+void fbl_rom_force(float z0, float r0, float mass, float c_d, float *F, float *dF_dz0, float *dF_dr0);
+
+/* The authors' ROM torque (downwash_torque_fo, world frame [N m]) for the upright neighbour: r_hat = p_top - p (ego), z_bm = world z. */
+void fbl_rom_torque(float z0, float r0, const float r_hat[3], float mass, float c_d, float tau_world[3]);
+
+void fbl_reset(fbl_state_t *s);
+
+/* One neighbour, explicit states (world frame); R = ego attitude (row-major, body -> world), inertia = diagonal of our J. Adds to out (acc, jerk, ang_acc,
+   n_active). Always contributes. */
+void fbl_residual_pair(const float p[3], const float v[3], const float R[9], const float p_top[3], const float v_top[3], float mass, float c_d,
+                       const float inertia[3], fbl_res_t *out);
+
+/* n <= FBL_MAX_NEIGHBOURS neighbours given as absolute states; sums the pairwise residuals (as the bundle does), then zeroes the yaw angular acceleration. */
+void fbl_residual_eval_abs(const float p[3], const float v[3], const float R[9], const float peer_p[][3], const float peer_v[][3], int n, float mass, float c_d,
+                           const float inertia[3], fbl_res_t *out);
+
+/* Peers from peer_get_all() (weak symbol, same API as for NS2): per-peer velocity by differencing with the NS2 rules (first sample -> zero velocity,
+ * unchanged timestamp -> last estimate, gap 0 < dt < 500 ms -> difference, otherwise resync with zero velocity). */
+void fbl_residual_eval(fbl_state_t *s, const float pos[3], const float vel[3], const float R[9], float mass, float c_d, const float inertia[3], fbl_res_t *out);
+
+#endif
