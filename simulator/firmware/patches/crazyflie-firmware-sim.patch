diff --git a/src/modules/src/fbl_residual.c b/src/modules/src/fbl_residual.c
new file mode 100644
index 00000000..69516b0a
--- /dev/null
+++ b/src/modules/src/fbl_residual.c
@@ -0,0 +1,199 @@
+#include "fbl_residual.h"
+#include <math.h>
+#include <string.h>
+
+/* The host SIL build renames peer_get_all (-Dpeer_get_all=peer_get_all_fw_unused, for traj_iface.c). This module must reference the
+   real name provided by the host layer (oot_host.c, injected peers) or by the firmware, exactly like ns2_residual.c. */
+#undef peer_get_all
+extern uint8_t peer_get_all(float *xs, float *ys, float *zs, uint32_t *ts, uint8_t max) __attribute__((weak));
+
+void fbl_reset(fbl_state_t *s) { memset(s, 0, sizeof(*s)); }
+
+static const fbl_nn_t *s_nn = 0;
+void fbl_residual_set_nn(const fbl_nn_t *nn) { s_nn = (nn != 0 && nn->nh > 0 && nn->nh <= FBL_NN_HMAX) ? nn : 0; }
+
+void fbl_nn_pair(const fbl_nn_t *nn, const float p[3], const float v[3], const float p_top[3], const float v_top[3], float acc[3], float jerk[3])
+{
+  /* geometry with the upper vehicle upright (flow axis +world z, zero derivative), d = ego - top */
+  const float d[3] = {p[0] - p_top[0], p[1] - p_top[1], p[2] - p_top[2]};
+  const float dd[3] = {v[0] - v_top[0], v[1] - v_top[1], v[2] - v_top[2]};
+  const float z0 = fabsf(d[2]);
+  const float dz0 = (d[2] > 0.0f ? 1.0f : (d[2] < 0.0f ? -1.0f : 0.0f)) * dd[2];
+  const float r0 = sqrtf(d[0] * d[0] + d[1] * d[1]);
+  const float dr0 = (d[0] * dd[0] + d[1] * dd[1]) / (r0 > 1e-12f ? r0 : 1e-12f);
+  /* network value and directional derivative */
+  float f[3] = {nn->b2[0], nn->b2[1], nn->b2[2]}, df[3] = {0.0f, 0.0f, 0.0f};
+  for (int k = 0; k < nn->nh; k++) {
+    const float hk = tanhf(nn->w1[k][0] * r0 + nn->w1[k][1] * z0 + nn->b1[k]);
+    const float gk = (1.0f - hk * hk) * (nn->w1[k][0] * dr0 + nn->w1[k][1] * dz0);
+    for (int i = 0; i < 3; i++) { f[i] += nn->w2[i][k] * hk; df[i] += nn->w2[i][k] * gk; }
+  }
+  /* flow frame [x_n y_n z_n] and its time derivative (Gram-Schmidt as in the bundle, r_hat = top - ego) */
+  const float rh[3] = {-d[0], -d[1], -d[2]}, rhd[3] = {-dd[0], -dd[1], -dd[2]};
+  const float nrm = sqrtf(rh[0] * rh[0] + rh[1] * rh[1] + rh[2] * rh[2]) + 1e-8f;
+  float x0[3], dx0[3];
+  for (int i = 0; i < 3; i++) x0[i] = rh[i] / nrm;
+  const float x0p = x0[0] * rhd[0] + x0[1] * rhd[1] + x0[2] * rhd[2];
+  for (int i = 0; i < 3; i++) dx0[i] = (rhd[i] - x0[i] * x0p) / nrm;
+  const float y0[3] = {-x0[1], x0[0], 0.0f}, dy0[3] = {-dx0[1], dx0[0], 0.0f};          /* z x x0, z = (0, 0, 1) */
+  float yn0 = sqrtf(y0[0] * y0[0] + y0[1] * y0[1]); if (yn0 < 1e-8f) yn0 = 1e-8f;
+  const float yn[3] = {y0[0] / yn0, y0[1] / yn0, 0.0f};
+  const float ynp = yn[0] * dy0[0] + yn[1] * dy0[1];
+  const float dyn[3] = {(dy0[0] - yn[0] * ynp) / yn0, (dy0[1] - yn[1] * ynp) / yn0, 0.0f};
+  const float x1[3] = {yn[1], -yn[0], 0.0f}, dx1[3] = {dyn[1], -dyn[0], 0.0f};          /* y_n x z */
+  float xn0 = sqrtf(x1[0] * x1[0] + x1[1] * x1[1]); if (xn0 < 1e-8f) xn0 = 1e-8f;
+  const float xn[3] = {x1[0] / xn0, x1[1] / xn0, 0.0f};
+  const float xnp = xn[0] * dx1[0] + xn[1] * dx1[1];
+  const float dxn[3] = {(dx1[0] - xn[0] * xnp) / xn0, (dx1[1] - xn[1] * xnp) / xn0, 0.0f};
+  /* acc = R f, jerk = dR f + R df (dz_n = 0) */
+  for (int i = 0; i < 3; i++) {
+    const float zi = (i == 2) ? 1.0f : 0.0f;
+    acc[i] += xn[i] * f[0] + yn[i] * f[1] + zi * f[2];
+    jerk[i] += dxn[i] * f[0] + dyn[i] * f[1] + xn[i] * df[0] + yn[i] * df[1] + zi * df[2];
+  }
+}
+
+/* ---- ROM: the authors' closed-form jet profile on their 10 x 10 trapezoid grid (force_batch_fo.py / torque_batch_fo.py), float32 ---------------- */
+#define ROM_G 9.81f
+#define ROM_RHO 1.293f
+#define ROM_PI 3.14159265358979f
+#define ROM_BD 6.84f
+#define ROM_Z0C 3.08f                 /* virtual origin of the jet: zeta = z0 / l + 3.08 */
+#define ROM_ALPHA 0.414213562f        /* sqrt(2) - 1 */
+#define ROM_S 0.0997f                 /* jet spreading S */
+#define ROM_RPROP_VEL 0.0225f         /* propeller radius of the velocity field (0.045 / 2): the bundle's value, not measured on our drone */
+#define ROM_NG 10
+static const float COS_TH[ROM_NG] = {1.0f, 7.660444431e-01f, 1.736481777e-01f, -5.0e-01f, -9.396926208e-01f, -9.396926208e-01f, -5.0e-01f, 1.736481777e-01f, 7.660444431e-01f, 1.0f};
+static const float SIN_TH[ROM_NG] = {0.0f, 6.427876097e-01f, 9.848077530e-01f, 8.660254038e-01f, 3.420201433e-01f, -3.420201433e-01f, -8.660254038e-01f, -9.848077530e-01f, -6.427876097e-01f, -2.449293598e-16f};
+
+/* radial grid r_j = quad_rad * j / 9 and the trapezoid weight per grid point: 0.25 * dr * dth * (rows touched: 1 at the ends, else 2) * (r_mid of the
+   cells touched in the column): the four-corner sum of the authors' cell formula collected per grid point. wb[j] excludes the row factor and 0.25 dr dth. */
+static void rom_grid(float quad_rad, float rj[ROM_NG], float wb[ROM_NG], float *scale)
+{
+  float mid[ROM_NG - 1];
+  for (int j = 0; j < ROM_NG; j++) rj[j] = quad_rad * (float)j / (float)(ROM_NG - 1);
+  for (int j = 0; j < ROM_NG - 1; j++) mid[j] = 0.5f * (rj[j] + rj[j + 1]);
+  for (int j = 0; j < ROM_NG; j++) wb[j] = (j > 0 ? mid[j - 1] : 0.0f) + (j < ROM_NG - 1 ? mid[j] : 0.0f);
+  *scale = 0.25f * (quad_rad / (float)(ROM_NG - 1)) * (2.0f * ROM_PI / (float)(ROM_NG - 1));
+}
+
+void fbl_rom_force(float z0, float r0, float mass, float c_d, float *F, float *dF_dz0, float *dF_dr0)
+{
+  const float l = 2.0f * (FBL_ROM_ARM_LENGTH + ROM_RPROP_VEL);
+  const float K = (mass * ROM_G / (2.0f * ROM_RHO * ROM_PI * ROM_RPROP_VEL * ROM_RPROP_VEL * 4.0f)) * (ROM_BD * ROM_BD);
+  float rj[ROM_NG], wb[ROM_NG], scale;
+  rom_grid(FBL_ROM_ARM_LENGTH + 0.025f + 0.001f, rj, wb, &scale);       /* integration radius: arm + 0.05 / 2 + 0.001 */
+  const float zeta = z0 / l + ROM_Z0C, lSz = l * ROM_S * zeta;
+  float tF = 0.0f, tz = 0.0f, tr = 0.0f;
+  for (int a = 0; a < ROM_NG; a++) {
+    const float cth = COS_TH[a], rowf = (a == 0 || a == ROM_NG - 1) ? 1.0f : 2.0f;
+    for (int b = 0; b < ROM_NG; b++) {
+      const float r = rj[b];
+      float rp2 = r0 * r0 + r * r + 2.0f * r0 * r * cth;
+      if (rp2 < 0.0f) rp2 = 0.0f;
+      const float Rpt = sqrtf(rp2), eta = Rpt / lSz, e2 = eta * eta, f = 1.0f + ROM_ALPHA * e2, f2 = f * f;
+      const float Vsq = K / (zeta * zeta * f2 * f2);
+      const float dVz = Vsq / (zeta * l) * (-2.0f + 8.0f * ROM_ALPHA * e2 / f);
+      const float dR = (r0 + r * cth) / (Rpt > 1e-15f ? Rpt : 1e-15f);
+      const float dVr = Vsq * (-8.0f * ROM_ALPHA * eta / f) / lSz * dR;
+      const float w = rowf * wb[b];
+      tF += w * Vsq; tz += w * dVz; tr += w * dVr;
+    }
+  }
+  const float coeff = 0.5f * c_d * ROM_RHO * scale;
+  *F = coeff * tF; *dF_dz0 = coeff * tz; *dF_dr0 = coeff * tr;
+}
+
+void fbl_rom_torque(float z0, float r0, const float r_hat[3], float mass, float c_d, float tau_world[3])
+{
+  const float l = 2.0f * (FBL_ROM_ARM_LENGTH + ROM_RPROP_VEL) + 0.002f;   /* torque_batch_fo.py: quad diameter + 0.002 */
+  const float K = (mass * ROM_G / (2.0f * ROM_RHO * ROM_PI * ROM_RPROP_VEL * ROM_RPROP_VEL * 4.0f)) * (ROM_BD * ROM_BD);
+  float rj[ROM_NG], wb[ROM_NG], scale;
+  rom_grid(FBL_ROM_ARM_LENGTH + ROM_RPROP_VEL + 0.001f, rj, wb, &scale);  /* integration radius: arm + 0.045 / 2 + 0.001 */
+  const float zeta = z0 / l + ROM_Z0C, lSz = l * ROM_S * zeta;
+  float o0 = 0.0f, o1 = 0.0f;
+  for (int a = 0; a < ROM_NG; a++) {
+    const float cth = COS_TH[a], sth = SIN_TH[a], rowf = (a == 0 || a == ROM_NG - 1) ? 1.0f : 2.0f;
+    for (int b = 0; b < ROM_NG; b++) {
+      const float r = rj[b];
+      float rp2 = r0 * r0 + r * r - 2.0f * r0 * r * cth;                  /* the torque grid uses the minus sign (the force grid the plus sign) */
+      if (rp2 < 0.0f) rp2 = 0.0f;
+      const float eta = sqrtf(rp2) / lSz, f = 1.0f + ROM_ALPHA * eta * eta, f2 = f * f;
+      const float w = rowf * wb[b] * (K / (zeta * zeta * f2 * f2));
+      o0 += w * (-r * sth); o1 += w * (r * cth);                            /* -(p x e_z) with p = (r cos, r sin, 0) = (-r sin, r cos, 0) */
+    }
+  }
+  /* virtual-wind frame (flow axis = world z): y = z x x_hat, x = y x z, each normalised with the bundle's 1e-12 floor */
+  const float nr = sqrtf(r_hat[0] * r_hat[0] + r_hat[1] * r_hat[1] + r_hat[2] * r_hat[2]) + 1e-18f;
+  const float x0 = r_hat[0] / nr, x1 = r_hat[1] / nr;
+  float ny = sqrtf(x0 * x0 + x1 * x1); if (ny < 1e-12f) ny = 1e-12f;
+  const float y0 = -x1 / ny, y1 = x0 / ny;
+  float nx = sqrtf(y0 * y0 + y1 * y1); if (nx < 1e-12f) nx = 1e-12f;
+  const float xn0 = y1 / nx, xn1 = -y0 / nx;
+  const float coeff = 0.5f * c_d * ROM_RHO * scale;
+  tau_world[0] = coeff * (xn0 * o0 + y0 * o1); tau_world[1] = coeff * (xn1 * o0 + y1 * o1); tau_world[2] = 0.0f;
+}
+
+void fbl_residual_pair(const float p[3], const float v[3], const float R[9], const float p_top[3], const float v_top[3], float mass, float c_d,
+                       const float inertia[3], fbl_res_t *out)
+{
+  /* point_line_distance with the flow axis = world z: r0 horizontal distance, z0 = |height difference| (the neighbour may be above OR below), no gate */
+  const float d[3] = {p[0] - p_top[0], p[1] - p_top[1], p[2] - p_top[2]};
+  const float dd[3] = {v[0] - v_top[0], v[1] - v_top[1], v[2] - v_top[2]};
+  const float z0 = fabsf(d[2]);
+  const float dz0 = (d[2] > 0.0f ? 1.0f : (d[2] < 0.0f ? -1.0f : 0.0f)) * dd[2];                 /* sign(t) * dt/dt */
+  const float r0 = sqrtf(d[0] * d[0] + d[1] * d[1]);
+  const float dr0 = (d[0] * dd[0] + d[1] * dd[1]) / (r0 > 1e-12f ? r0 : 1e-12f);
+  float F, dFz, dFr;
+  fbl_rom_force(z0, r0, mass, c_d, &F, &dFz, &dFr);
+  out->acc[2] += -F / mass;
+  out->jerk[2] += (-1.0f / mass) * (dFz * dz0 + dFr * dr0);
+  if (s_nn) fbl_nn_pair(s_nn, p, v, p_top, v_top, out->acc, out->jerk);
+  /* ROM torque -> body angular acceleration (no torque network: we have none) */
+  const float rh[3] = {-d[0], -d[1], -d[2]};
+  float tw[3];
+  fbl_rom_torque(z0, r0, rh, mass, c_d, tw);
+  for (int i = 0; i < 3; i++) {
+    const float tb = R[0 * 3 + i] * tw[0] + R[1 * 3 + i] * tw[1] + R[2 * 3 + i] * tw[2];
+    out->ang_acc[i] += tb / inertia[i];
+  }
+  out->n_active++;
+}
+
+void fbl_residual_eval_abs(const float p[3], const float v[3], const float R[9], const float peer_p[][3], const float peer_v[][3], int n, float mass, float c_d,
+                           const float inertia[3], fbl_res_t *out)
+{
+  memset(out, 0, sizeof(*out));
+  if (n > FBL_MAX_NEIGHBOURS) n = FBL_MAX_NEIGHBOURS;
+  for (int k = 0; k < n; k++) fbl_residual_pair(p, v, R, peer_p[k], peer_v[k], mass, c_d, inertia, out);
+  out->ang_acc[2] = 0.0f;           /* _predict_residual: the learned model predicts a near-constant yaw torque bias; zeroed */
+}
+
+void fbl_residual_eval(fbl_state_t *s, const float pos[3], const float vel[3], const float R[9], float mass, float c_d, const float inertia[3], fbl_res_t *out)
+{
+  float xs[FBL_MAX_NEIGHBOURS] = {0}, ys[FBL_MAX_NEIGHBOURS] = {0}, zs[FBL_MAX_NEIGHBOURS] = {0};
+  uint32_t ts[FBL_MAX_NEIGHBOURS] = {0};
+  float pp[FBL_MAX_NEIGHBOURS][3] = {{0}}, pv[FBL_MAX_NEIGHBOURS][3] = {{0}};
+  int n = 0;
+  if (peer_get_all != 0) n = (int)peer_get_all(xs, ys, zs, ts, FBL_MAX_NEIGHBOURS);
+  if (n > FBL_MAX_NEIGHBOURS) n = FBL_MAX_NEIGHBOURS;
+  for (int k = 0; k < n; k++) {
+    const uint32_t pt = s->prev[k].ts, ts_new = ts[k], dt_ms = ts_new - pt;
+    if (pt == 0) {
+      s->prev[k].x = xs[k]; s->prev[k].y = ys[k]; s->prev[k].z = zs[k]; s->prev[k].ts = ts_new;
+      s->vel[k][0] = s->vel[k][1] = s->vel[k][2] = 0.0f;
+    } else if (ts_new == pt) {
+      /* unchanged timestamp: keep the last estimate */
+    } else if (dt_ms > 0 && dt_ms < 500) {
+      const float inv = 1000.0f / (float)dt_ms;
+      s->vel[k][0] = (xs[k] - s->prev[k].x) * inv; s->vel[k][1] = (ys[k] - s->prev[k].y) * inv; s->vel[k][2] = (zs[k] - s->prev[k].z) * inv;
+      s->prev[k].x = xs[k]; s->prev[k].y = ys[k]; s->prev[k].z = zs[k]; s->prev[k].ts = ts_new;
+    } else {
+      s->prev[k].x = xs[k]; s->prev[k].y = ys[k]; s->prev[k].z = zs[k]; s->prev[k].ts = ts_new;
+      s->vel[k][0] = s->vel[k][1] = s->vel[k][2] = 0.0f;
+    }
+    pp[k][0] = xs[k]; pp[k][1] = ys[k]; pp[k][2] = zs[k];
+    pv[k][0] = s->vel[k][0]; pv[k][1] = s->vel[k][1]; pv[k][2] = s->vel[k][2];
+  }
+  fbl_residual_eval_abs(pos, vel, R, (const float (*)[3])pp, (const float (*)[3])pv, n, mass, c_d, inertia, out);
+}
diff --git a/src/modules/src/ns2_residual.c b/src/modules/src/ns2_residual.c
new file mode 100644
index 00000000..443b5183
--- /dev/null
+++ b/src/modules/src/ns2_residual.c
@@ -0,0 +1,293 @@
+/*
+ * NS2 learned interaction residual -- C implementation (see ns2_residual.h).
+ * Exact counterpart of flying_drone_stack/firmware_app/src/residual_nn.rs and the peer logic in src/lib.rs.
+ */
+#include <math.h>
+#include <string.h>
+
+#include "ns2_residual.h"
+#include "usec_time.h"
+
+/* The host SIL build renames peer_get_all (-Dpeer_get_all=peer_get_all_fw_unused, for traj_iface.c). This module
+ * must call the real one (the injected stub on the host, traj_iface.c on the drone), like host/oot_host.c does. */
+#undef peer_get_all
+
+#define PHI_IN_S 6
+#define PHI_IN_G 4
+#define PHI_L1 25
+#define PHI_L2 40
+#define PHI_L3 40
+#define HIDDEN 20
+#define RHO_L1 40
+#define RHO_L2 40
+#define RHO_L3 40
+#define N_PHI_S 3675
+#define N_PHI_G 3625
+#define N_RHO 4161
+
+#define GATE_DXY 0.2f
+#define GATE_DVX 1.5f
+#define GRAMS_TO_NEWTONS (9.81f / 1000.0f)
+#define OUT_CLAMP 8.0f
+
+/* Symbols provided by firmware_app (traj_iface.c, ns2_weights.c). Weak so that a build without the app still
+ * links; the module is then inert (no weights, rnn.* untouched). */
+extern const float ns2_w_phi_s[N_PHI_S] __attribute__((weak));
+extern const float ns2_w_phi_g[N_PHI_G] __attribute__((weak));
+extern const float ns2_w_rho_s[N_RHO] __attribute__((weak));
+extern uint8_t peer_get_all(float *xs, float *ys, float *zs, uint32_t *ts, uint8_t max) __attribute__((weak));
+extern void rnn_pred_write(float x, float y, float z, uint8_t clamped) __attribute__((weak));
+extern uint8_t g_rnn_en __attribute__((weak));
+extern uint8_t g_rnn_ready __attribute__((weak));
+extern uint8_t g_rnn_div __attribute__((weak));
+extern uint8_t g_rnn_rst __attribute__((weak));
+extern uint16_t g_rnn_us_last __attribute__((weak));
+extern uint16_t g_rnn_us_max __attribute__((weak));
+extern float g_rnn_us_avg __attribute__((weak));
+
+/* Scratch (single caller: the stabilizer task; the host runs drones sequentially in one thread). */
+static float phi_h1[PHI_L1];
+static float phi_h2[PHI_L2];
+static float phi_h3[PHI_L3];
+static float phi_out[HIDDEN];
+static float rho_h1[RHO_L1];
+static float rho_h2[RHO_L2];
+static float rho_h3[RHO_L3];
+static float rho_out[1];
+static float rho_in[HIDDEN];
+
+bool ns2_weights_present(void)
+{
+  return (&ns2_w_phi_s[0] != 0) && (&ns2_w_phi_g[0] != 0) && (&ns2_w_rho_s[0] != 0);
+}
+
+/* One fully-connected layer with ReLU: n_out rows of n_in weights, then n_out biases (nn.Linear). Returns the
+ * offset just past the weights it consumed. */
+static int layer_relu(const float *w, int off, const float *x, int n_in, float *y, int n_out)
+{
+  for (int j = 0; j < n_out; j++) {
+    float acc = w[off + n_out * n_in + j];
+    const int row = off + j * n_in;
+    for (int i = 0; i < n_in; i++) {
+      acc += w[row + i] * x[i];
+    }
+    y[j] = (acc > 0.0f) ? acc : 0.0f;
+  }
+  return off + n_out * n_in + n_out;
+}
+
+static int layer_linear(const float *w, int off, const float *x, int n_in, float *y, int n_out)
+{
+  for (int j = 0; j < n_out; j++) {
+    float acc = w[off + n_out * n_in + j];
+    const int row = off + j * n_in;
+    for (int i = 0; i < n_in; i++) {
+      acc += w[row + i] * x[i];
+    }
+    y[j] = acc;
+  }
+  return off + n_out * n_in + n_out;
+}
+
+static void phi_forward(const float *w, const float *x, int n_in)
+{
+  int o = 0;
+  o = layer_relu(w, o, x, n_in, phi_h1, PHI_L1);
+  o = layer_relu(w, o, phi_h1, PHI_L1, phi_h2, PHI_L2);
+  o = layer_relu(w, o, phi_h2, PHI_L2, phi_h3, PHI_L3);
+  (void)layer_linear(w, o, phi_h3, PHI_L3, phi_out, HIDDEN);
+}
+
+static float rho_forward(const float *w, const float *x)
+{
+  int o = 0;
+  o = layer_relu(w, o, x, HIDDEN, rho_h1, RHO_L1);
+  o = layer_relu(w, o, rho_h1, RHO_L1, rho_h2, RHO_L2);
+  o = layer_relu(w, o, rho_h2, RHO_L2, rho_h3, RHO_L3);
+  (void)layer_linear(w, o, rho_h3, RHO_L3, rho_out, 1);
+  return rho_out[0];
+}
+
+void ns2_reset(ns2_state_t *s)
+{
+  memset(s, 0, sizeof(*s));
+}
+
+void ns2_eval_rel(const float rel_p[][3], const float rel_v[][3], int n,
+                  float own_z, const float own_vel[3], float mass,
+                  float out_accel[3], uint8_t *clamped)
+{
+  *clamped = 0;
+  out_accel[0] = out_accel[1] = out_accel[2] = 0.0f;
+  if (!ns2_weights_present()) {
+    return;
+  }
+
+  for (int i = 0; i < HIDDEN; i++) {
+    rho_in[i] = 0.0f;
+  }
+
+  /* Ground interaction -- unconditional, every evaluation, regardless of neighbours. */
+  {
+    const float ground_x[PHI_IN_G] = {0.0f - own_z, -own_vel[0], -own_vel[1], -own_vel[2]};
+    phi_forward(ns2_w_phi_g, ground_x, PHI_IN_G);
+    for (int i = 0; i < HIDDEN; i++) {
+      rho_in[i] += phi_out[i];
+    }
+  }
+
+  /* Neighbours: every vehicle here is "small", so always phi_S / rho_S. */
+  const int nn = (n < NS2_MAX_NEIGHBOURS) ? n : NS2_MAX_NEIGHBOURS;
+  for (int k = 0; k < nn; k++) {
+    const float *dp = rel_p[k];
+    const float *dv = rel_v[k];
+    const bool gated = (fabsf(dp[0]) < GATE_DXY) && (fabsf(dp[1]) < GATE_DXY) && (fabsf(dv[0]) < GATE_DVX);
+    if (!gated) {
+      continue;
+    }
+    const float x[PHI_IN_S] = {dp[0], dp[1], dp[2], dv[0], dv[1], dv[2]};
+    phi_forward(ns2_w_phi_s, x, PHI_IN_S);
+    for (int i = 0; i < HIDDEN; i++) {
+      rho_in[i] += phi_out[i];
+    }
+  }
+
+  const float faz_grams = rho_forward(ns2_w_rho_s, rho_in);
+  float faz_accel = (faz_grams * GRAMS_TO_NEWTONS) / mass;
+
+  if (!isfinite(faz_accel)) {
+    *clamped = 1;
+    return;
+  }
+  const float mag = fabsf(faz_accel);
+  if (mag > OUT_CLAMP) {
+    *clamped = 1;
+    faz_accel = faz_accel * (OUT_CLAMP / mag);
+  }
+  out_accel[2] = faz_accel;
+}
+
+void ns2_eval(ns2_state_t *s, const float pos[3], const float vel[3], float mass,
+              float out_accel[3], uint8_t *clamped)
+{
+  float xs[NS2_MAX_NEIGHBOURS] = {0}, ys[NS2_MAX_NEIGHBOURS] = {0}, zs[NS2_MAX_NEIGHBOURS] = {0};
+  uint32_t ts[NS2_MAX_NEIGHBOURS] = {0};
+  float rel_p[NS2_MAX_NEIGHBOURS][3] = {{0}};
+  float rel_v[NS2_MAX_NEIGHBOURS][3] = {{0}};
+  int n = 0;
+
+  if (peer_get_all != 0) {
+    n = (int)peer_get_all(xs, ys, zs, ts, NS2_MAX_NEIGHBOURS);
+  }
+  if (n > NS2_MAX_NEIGHBOURS) {
+    n = NS2_MAX_NEIGHBOURS;
+  }
+
+  for (int k = 0; k < n; k++) {
+    float v_peer[3];
+    const uint32_t pt = s->prev[k].ts;
+    const uint32_t ts_new = ts[k];
+    const uint32_t dt_ms = ts_new - pt;  /* wraps like u32::wrapping_sub */
+
+    if (pt == 0) {
+      /* First time seen: no baseline yet, zero relative velocity. */
+      s->prev[k].x = xs[k]; s->prev[k].y = ys[k]; s->prev[k].z = zs[k]; s->prev[k].ts = ts_new;
+      s->vel[k][0] = s->vel[k][1] = s->vel[k][2] = 0.0f;
+      v_peer[0] = v_peer[1] = v_peer[2] = 0.0f;
+    } else if (ts_new == pt) {
+      /* Timestamp has not advanced: reuse the last estimate. */
+      v_peer[0] = s->vel[k][0]; v_peer[1] = s->vel[k][1]; v_peer[2] = s->vel[k][2];
+    } else if (dt_ms > 0 && dt_ms < 500) {
+      const float inv = 1000.0f / (float)dt_ms;
+      v_peer[0] = (xs[k] - s->prev[k].x) * inv;
+      v_peer[1] = (ys[k] - s->prev[k].y) * inv;
+      v_peer[2] = (zs[k] - s->prev[k].z) * inv;
+      s->vel[k][0] = v_peer[0]; s->vel[k][1] = v_peer[1]; s->vel[k][2] = v_peer[2];
+      s->prev[k].x = xs[k]; s->prev[k].y = ys[k]; s->prev[k].z = zs[k]; s->prev[k].ts = ts_new;
+    } else {
+      /* Timestamp advanced but the gap is invalid (>= 500 ms, wrap, backwards): resync like first-seen. */
+      s->prev[k].x = xs[k]; s->prev[k].y = ys[k]; s->prev[k].z = zs[k]; s->prev[k].ts = ts_new;
+      s->vel[k][0] = s->vel[k][1] = s->vel[k][2] = 0.0f;
+      v_peer[0] = v_peer[1] = v_peer[2] = 0.0f;
+    }
+
+    rel_p[k][0] = xs[k] - pos[0]; rel_p[k][1] = ys[k] - pos[1]; rel_p[k][2] = zs[k] - pos[2];
+    rel_v[k][0] = v_peer[0] - vel[0]; rel_v[k][1] = v_peer[1] - vel[1]; rel_v[k][2] = v_peer[2] - vel[2];
+  }
+
+  ns2_eval_rel((const float (*)[3])rel_p, (const float (*)[3])rel_v, n, pos[2], vel, mass, out_accel, clamped);
+}
+
+void ns2_publish_ready(void)
+{
+#ifndef UNIT_TEST_MODE
+  if (&g_rnn_ready != 0) {
+    g_rnn_ready = ns2_weights_present() ? 1 : 0;
+  }
+#endif
+}
+
+bool ns2_active(void)
+{
+  if (!ns2_weights_present() || (&g_rnn_en == 0) || (g_rnn_en == 0)) {
+    return false;
+  }
+#ifndef UNIT_TEST_MODE
+  if ((&g_rnn_ready == 0) || (g_rnn_ready == 0)) {
+    return false;
+  }
+#endif
+  return true;
+}
+
+void ns2_update(ns2_state_t *s, const float pos[3], const float vel[3], float mass, uint32_t tick)
+{
+  /* Weights are in flash: the network is ready from boot (the Rust rnn_service that sets this for controller 6
+   * does not run while controller 9 is selected). Firmware builds only, see ns2_publish_ready(). */
+  ns2_publish_ready();
+
+  uint32_t div = 10;
+  if (&g_rnn_div != 0) {
+    div = (g_rnn_div == 0) ? 1 : g_rnn_div;
+  }
+
+  const bool do_eval = (s->started == 0) || ((tick % div) == 0);
+  if (do_eval) {
+#ifndef UNIT_TEST_MODE
+    const uint64_t t0 = usecTimestamp();
+#endif
+    float out[3];
+    uint8_t cl = 0;
+    ns2_eval(s, pos, vel, mass, out, &cl);
+#ifndef UNIT_TEST_MODE
+    const uint64_t t1 = usecTimestamp();
+#endif
+    s->hold[0] = out[0]; s->hold[1] = out[1]; s->hold[2] = out[2];
+    s->hold_clamped = cl;
+    s->started = 1;
+
+    /* Timing, same bookkeeping as rnn_record_timing in lib.rs. Skipped in host builds: the host's usecTimestamp()
+     * stub advances a fake clock by 2000 us per CALL, so two extra calls here would change the dt that the
+     * Omar INDI derives from the same clock (a simulation artifact, not a hardware effect). */
+#ifndef UNIT_TEST_MODE
+    if (&g_rnn_us_last != 0 && &g_rnn_us_max != 0 && &g_rnn_us_avg != 0) {
+      if (&g_rnn_rst != 0 && g_rnn_rst != 0) {
+        g_rnn_us_max = 0;
+        g_rnn_us_avg = 0.0f;
+        g_rnn_rst = 0;
+      }
+      uint32_t us = (uint32_t)(t1 - t0);
+      const uint16_t us16 = (us > 65535u) ? 65535u : (uint16_t)us;
+      g_rnn_us_last = us16;
+      if (us16 > g_rnn_us_max) {
+        g_rnn_us_max = us16;
+      }
+      g_rnn_us_avg = g_rnn_us_avg * (15.0f / 16.0f) + ((float)us) * (1.0f / 16.0f);
+    }
+#endif
+  }
+
+  if (rnn_pred_write != 0) {
+    rnn_pred_write(s->hold[0], s->hold[1], s->hold[2], s->hold_clamped);
+  }
+}
