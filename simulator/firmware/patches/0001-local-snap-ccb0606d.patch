From ccb0606ddcfe58ca2aad240d3eed4cda3afe8ff0 Mon Sep 17 00:00:00 2001
From: Georg Wolnik <wolnik.georg0317@gmail.com>
Date: Thu, 11 Jun 2026 16:21:44 +0200
Subject: [PATCH] add snap.

---
 configs/cf2_defconfig                       | 2 ++
 src/modules/interface/pptraj.h              | 1 +
 src/modules/interface/stabilizer_types.h    | 1 +
 src/modules/src/crtp_commander_high_level.c | 3 +++
 src/modules/src/pptraj.c                    | 6 ++++++
 vendor/libdw1000                            | 2 +-
 6 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/configs/cf2_defconfig b/configs/cf2_defconfig
index a8ff4d66..d997c63e 100644
--- a/configs/cf2_defconfig
+++ b/configs/cf2_defconfig
@@ -1 +1,3 @@
 CONFIG_PLATFORM_CF2=y
+CONFIG_DECK_RPM=y
+CONFIG_DECK_FORCE="bcRpm"
\ No newline at end of file
diff --git a/src/modules/interface/pptraj.h b/src/modules/interface/pptraj.h
index 0ae10f76..c1f25227 100644
--- a/src/modules/interface/pptraj.h
+++ b/src/modules/interface/pptraj.h
@@ -121,6 +121,7 @@ struct traj_eval
 	struct vec vel;
 	struct vec acc;
 	struct vec jerk;
+	struct vec snap;     // 4th derivative — for INDI snap feedforward (Tal & Karaman Eq. 15)
 	struct vec omega;
 	float yaw;
 };
diff --git a/src/modules/interface/stabilizer_types.h b/src/modules/interface/stabilizer_types.h
index dff1eb36..9751c300 100644
--- a/src/modules/interface/stabilizer_types.h
+++ b/src/modules/interface/stabilizer_types.h
@@ -259,6 +259,7 @@ typedef struct setpoint_s {
   velocity_t velocity;      // m/s
   acc_t acceleration;       // m/s^2
   jerk_t jerk;              // m/s^3
+  acc_t snap;               // m/s^4 — INDI feedforward (Tal & Karaman Eq. 15)
   bool velocity_body;       // true if velocity is given in body frame; false if velocity is given in world frame
 
   struct {
diff --git a/src/modules/src/crtp_commander_high_level.c b/src/modules/src/crtp_commander_high_level.c
index 08cdd5e2..6c9900a7 100644
--- a/src/modules/src/crtp_commander_high_level.c
+++ b/src/modules/src/crtp_commander_high_level.c
@@ -395,6 +395,9 @@ bool crtpCommanderHighLevelGetSetpoint(setpoint_t* setpoint, const state_t *stat
     setpoint->jerk.x = ev.jerk.x;
     setpoint->jerk.y = ev.jerk.y;
     setpoint->jerk.z = ev.jerk.z;
+    setpoint->snap.x = ev.snap.x;
+    setpoint->snap.y = ev.snap.y;
+    setpoint->snap.z = ev.snap.z;
 
 
     // store the last setpoint
diff --git a/src/modules/src/pptraj.c b/src/modules/src/pptraj.c
index 9fb5dca1..56ac963a 100644
--- a/src/modules/src/pptraj.c
+++ b/src/modules/src/pptraj.c
@@ -271,6 +271,8 @@ struct traj_eval traj_eval_zero()
 		.pos = vzero(),
 		.vel = vzero(),
 		.acc = vzero(),
+		.jerk = vzero(),
+		.snap = vzero(),
 		.yaw = 0.0f,
 		.omega = vzero(),
 	};
@@ -311,6 +313,10 @@ struct traj_eval poly4d_eval(struct poly4d const *p, float t)
 	polyder4d(deriv);
 	out.jerk = polyval_xyz(deriv, t);
 
+	// 4th derivative — snap (for INDI feedforward, Tal & Karaman Eq. 15)
+	polyder4d(deriv);
+	out.snap = polyval_xyz(deriv, t);
+
 	struct vec thrust = vadd(out.acc, mkvec(0, 0, GRAV));
 	// float thrust_mag = mass * vmag(thrust);
 
diff --git a/vendor/libdw1000 b/vendor/libdw1000
index c472ae93..a7761032 160000
--- a/vendor/libdw1000
+++ b/vendor/libdw1000
@@ -1 +1 @@
-Subproject commit c472ae93f839520ccdf76cc193c76214e73e42fd
+Subproject commit a77610327fb875a69543f3a8d19507683b68aff1
-- 
2.34.1

