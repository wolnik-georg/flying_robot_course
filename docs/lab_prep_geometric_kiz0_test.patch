# Lab-only: geometric ki_z A/B on cf5 (DEFAULT firmware, Step A binary).
# Target: crazyswarm2 @ c13546a — crazyflie/config/crazyflies.yaml
# cf5 is already ctrl_mode=0, ki_z=16; this patch sets ki_z=0 for the B leg only.
#
# Pass/fail (each setting, ≥2–3 attempts): no |roll| or |pitch| >20° within 3 s of liftoff.
# Compare ki_z=16 (yaml default, no patch) vs ki_z=0 (with patch) on the SAME default firmware.
#
# Usage (lab PC):
#   WS=~/georg/ros2_ws
#   cd $WS/src/crazyswarm2
#   git apply $REPO/docs/lab_prep_geometric_kiz0_test.patch
#   # fly (A1 or short hover per protocol)
#   git checkout -- crazyflie/config/crazyflies.yaml
#
# Regenerated 2026-10-03; verified: git apply --check against c13546a (exit 0).
diff --git a/crazyflie/config/crazyflies.yaml b/crazyflie/config/crazyflies.yaml
index dd73bca..2067f51 100644
--- a/crazyflie/config/crazyflies.yaml
+++ b/crazyflie/config/crazyflies.yaml
@@ -232,8 +232,8 @@ robots:
