#!/usr/bin/env python3
"""Stage 4a C2: one command per DiffCoTune round on the real drone (desk side; nothing is flown, flashed or written to crazyswarm2).

  round.py --init                        --controller S0 [--state-dir lab/S0]        writes round_0 (default gains yaml + state)
  round.py --controller S0 --round l --logs <folder>  [--state-dir lab/S0] [--n-rounds 5] [--grad-mode reverse|forward]

Folder layout (state-dir = experiments/diffcotune/lab/S0):
  round_<l>/gains.yaml        gains FLOWN in round l (written by round l-1; defaults for l = 0), crazyswarm2 yaml fragment, see GAIN_PARAMS
  round_<l>/state.json        state before round l: theta_l (phi, log-factors of the 10 gains), beta (psi, log-factors), keep-best, settings, seeds, history
  round_<l>/report.md|json    written by this command (real cost per scenario, flags, beta, theta, keep-best, desk time)
  round_<l+1>/gains.yaml, state.json   written by this command (not after the last round)
--logs <folder> holds the merged uSD files of the round and `flights.json`: a list of {file, scenario, cell (0-based index into the tuning / study cells), role (tuning | test),
attempt (1 = first flight, 2 / 3 = repeat after a crash or floor flight)}. Tuning scenarios of S0: A1, A8, CIRCLE, FIG8 (loop_lib.TUNING); test: A4 (2 cells), OVAL.

One round = ingest + quality gate -> real cost -> fit beta (50 + 1 epochs, noise-free J_sysId = position + velocity + attitude, best iterate; skipped in the last round) -> tune theta
(method version "A + B": J_task with 2 fixed noise seeds per round, +-25 % gain limit around theta_l, 50 + 1 epochs, best iterate, lr 0.01, Adam reset per inner loop) -> next gains.
A flight that fails the quality gate, tilts over (tilt >= 70 deg) or stays on the floor (floor rule) is not used; the scenario then needs a repeat (at most 2 repeats, attempt <= 3).
"""
import argparse, json, os, sys, time
from pathlib import Path
import numpy as np
os.environ.setdefault('TORCHINDUCTOR_COMPILE_THREADS', '1')
if '--controller' in sys.argv:            # Stage 5: the controller selects the model of loop_lib BEFORE it is imported (default S0 = Stage 4 behaviour)
    os.environ['DIFFCOTUNE_CONTROLLER'] = sys.argv[sys.argv.index('--controller') + 1]
# Stage 5b: gradient mode of the model (loop_lib.GRAD_MODE; same autodiff gradient, other differentiation mode). Default per controller, written here: S0 'reverse'; S1, S2, S3 'mixed' since Stage 5c (eager forward mode is exact but about 20-60 x slower, not adopted: dryrun/stage5b/report_stage5b.md; the compiled forward sensitivity of dryrun/stage5c/report_stage5c.md is as fast as reverse). --grad-mode overrides. Set BEFORE loop_lib is imported (spawned workers inherit it).
GRAD_MODE_DEFAULT = dict(S0='cfwd', S1='cfwd', S2='cfwd', S3='cfwd')          # Stage 7 (user decision 15 Nov): the compiled forward sensitivity for every gradient on every scenario, all four controllers (same gradient as reverse mode; reverse stays in the checks). Before: S0 reverse, S1-S3 mixed (Stage 5c)
_OLD_DEFAULT = dict(S0='reverse', S1='mixed2', S2='mixed2', S3='mixed2')          # Stage 7: mixed2 (= mixed + the noisy A1 task gradient of the tuning step by the compiled forward sensitivity; user decision 15 Nov, same gradient); was 'mixed' in Stage 5c          # Stage 5c: mixed = exact forward sensitivity (compiled) for the noise-free beta fit on A1, compiled reverse elsewhere (S0 unchanged)
# Stage 8b (user decision 15 Nov evening): the lab method is 'ours' (loop_lib.METHOD_SETTINGS['ours'], DiffCoTune's co-tuning loop with DiffTune's quadrotor settings, 6 rounds); `--method paper` selects the paper-faithful variant (tested in Stage 8, not adopted). The learning rate of the paper variant is
# DIFFCOTUNE_LR (default in loop_lib, chosen in Stage 8 step 1c). Set BEFORE loop_lib is imported.
if '--method' in sys.argv: os.environ['DIFFCOTUNE_METHOD'] = sys.argv[sys.argv.index('--method') + 1]
os.environ.setdefault('DIFFCOTUNE_METHOD', 'ours')          # Stage 8b (user decision 15 Nov evening): the lab variant is the frozen 'ours' for all four controllers; the paper-faithful variant was tested and not adopted
_ctrl = sys.argv[sys.argv.index('--controller') + 1] if '--controller' in sys.argv else 'S0'
os.environ['DIFFCOTUNE_GRAD_MODE'] = sys.argv[sys.argv.index('--grad-mode') + 1] if '--grad-mode' in sys.argv else GRAD_MODE_DEFAULT.get(_ctrl, 'reverse')
# Stage 5c, RPM delay fixed (user decision, 14 Nov 2026): S1 / S3 keep the RPM delay at the calibration (4.0502 ms) and fit the other four beta (loop_lib.FIX_RD). The table is True for S1 and S3 (flipped 15 Nov after the Stage 5c round tests with the delay fitted had run; switch: --fix-rd / --fit-rd). Set BEFORE loop_lib is imported.
FIX_RD_DEFAULT = dict(S0=False, S1=True, S2=False, S3=True)
os.environ['DIFFCOTUNE_FIX_RD'] = '1' if '--fix-rd' in sys.argv else ('0' if '--fit-rd' in sys.argv else ('1' if FIX_RD_DEFAULT.get(_ctrl, False) else '0'))
NO_PREVIEW = '--no-preview' in sys.argv          # Stage 8b
HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent)); sys.path.insert(0, str(HERE.parent / 'dryrun'))
import loop_lib as L  # noqa
import lab_pool as LP  # noqa
import usd_ingest as U  # noqa
import reference as R  # noqa
from frsim.scenarios import study_cells, tuning_cells  # noqa

# gain of the model -> firmware parameter(s) of the ctrlOmarIndi group (controller_omar_indi.c PARAM_GROUP ctrlOmarIndi, lines 679-717 of crazyflie-firmware); x and y tied
GAIN_PARAMS = [('Pxy', ['Kpos_Px', 'Kpos_Py']), ('Pz', ['Kpos_Pz']), ('Dxy', ['Kpos_Dx', 'Kpos_Dy']), ('Dz', ['Kpos_Dz']), ('Iz', ['Kpos_Iz']),
               ('KRxy', ['KR_x', 'KR_y']), ('KRz', ['KR_z']), ('Kwxy', ['Kw_x', 'Kw_y']), ('Kwz', ['Kw_z']), ('KIxy', ['KI_x', 'KI_y'])]
ROBOT = 'cf5'          # the study drone (crazyflies.yaml: cf5 = bottom, scored)
# the peer input of the S0 model: the LOGGED top-drone path for the two-drone tuning scenarios (decision 13 Nov: on 23 Oct A1 it moves the model from 10.1 to 20.4-20.7 cm against the real 20.5-22.1 cm)
TOP_FROM_LOG = ('A1', 'A8')
_M = L.METHOD_SETTINGS[L.METHOD]          # Stage 8: ours | paper (DIFFCOTUNE_METHOD)
SETTINGS = dict(method=L.METHOD, lr=_M['lr'], epochs=50, best_iterate=_M['best'], paper_stop=_M['paper_stop'], noise=_M['noise'], states=list(_M['states']), gain_limit=_M['gain_limit'], noise_seed_base=6000, n_noise_seeds=2, skip_last_fit=True, n_rounds=_M['n_rounds'], grad_mode=os.environ.get('DIFFCOTUNE_GRAD_MODE', 'reverse'), fix_rd=os.environ.get('DIFFCOTUNE_FIX_RD', '0') == '1')


def say(*a):
    print(time.strftime('%H:%M:%S'), *a, flush=True)


# ------------------------------------------------------------------------------------------------------------- yaml
def gains_to_yaml(phi, path, header=''):
    """theta -> crazyswarm2 yaml fragment (robots: cf5: firmware_params: ctrlOmarIndi: ...). Values written with repr (float64); the firmware stores float32."""
    g = L.gains_of(np.asarray(phi, float))
    lines = ['# DiffCoTune %s gains to fly (Stage 4a / 5). Merge into the cf5 block of the study_%s crazyflies.yaml; written by lab/round.py, not applied by it.' % (L.CTRL, L.CTRL)]
    lines += ['# ' + h for h in header.splitlines() if h]
    lines += ['robots:', '  %s:' % ROBOT, '    firmware_params:', '      ctrlOmarIndi:']
    for name, params in GAIN_PARAMS:
        for p in params:
            lines.append('        %s: %r' % (p, float(g[name])))
    Path(path).write_text('\n'.join(lines) + '\n')


def yaml_to_phi(path):
    """yaml fragment -> theta (phi = log(gain / default)); the x / y pairs must be equal."""
    import yaml
    d = yaml.safe_load(open(path))['robots'][ROBOT]['firmware_params']['ctrlOmarIndi']
    phi = np.zeros(10)
    for i, (name, params) in enumerate(GAIN_PARAMS):
        vals = [float(d[p]) for p in params]
        assert max(vals) == min(vals), 'tied gains differ: %s' % params
        phi[i] = np.log(vals[0] / L.GAIN_DEFAULT[i])
    return phi


# ------------------------------------------------------------------------------------------------------------- state
def init_state(sd):
    rd = Path(sd) / 'round_0'; rd.mkdir(parents=True, exist_ok=True)
    st = dict(round=0, phi=[0.0] * 10, psi=[0.0] * L.N_BETA, keep=None, history=[], settings=SETTINGS, controller=L.CTRL)
    json.dump(st, open(rd / 'state.json', 'w'), indent=1); gains_to_yaml(np.zeros(10), rd / 'gains.yaml', 'round 0: firmware default gains')
    return st


def cell_of(scen, role, idx):
    return (tuning_cells(scen) if (role in ('tuning', 'fallback') and scen != 'A4') else study_cells(scen))[idx]          # Stage 7: A4 cell 1 is a tuning scenario (study cell 0 of A4)


# ------------------------------------------------------------------------------------------------------------- the round
def run_round(l, folder, sd, top='auto', strict=True):
    t_start = time.time(); sd = Path(sd); folder = Path(folder); rd = sd / ('round_%d' % l)
    st = json.load(open(rd / 'state.json')); S = st['settings']; assert st['round'] == l, 'state is for round %d' % st['round']
    phi_l = np.array(st['phi']); psi = np.array(st['psi']); last = l == S['n_rounds'] - 1
    man = json.load(open(folder / 'flights.json'))
    # 1. ingest + gate + selection
    t0 = time.time(); ing = []
    for m in man:
        cell = cell_of(m['scenario'], m['role'], m['cell'])
        use_top = (top == 'logged') or (top == 'auto' and m['scenario'] in TOP_FROM_LOG)
        g = U.ingest_flight(folder / m['file'], m['scenario'], cell, top_from_log=use_top, rotate_deg=m.get('rotate_deg'), lag_s=m.get('lag_s'))
        g.update(m=m, cell=cell); ing.append(g)
        say('ingest %-40s %s attempt %d: gate %s, crashed %s floor %s, real %.2f cm' % (m['file'], m['scenario'], m['attempt'], 'ok' if g['gate']['ok'] else g['gate']['reasons'],
            g.get('flags', {}).get('crashed'), g.get('flags', {}).get('floor'), g.get('rms3d_cm', float('nan'))))
    def good(g):
        if not strict: return g.get('usable', False)      # strict=False only for the dry test: loop_lib fits a floor flight of theta_0 (A1) too
        return g.get('usable', False) and not g['flags']['crashed'] and not g['flags']['floor']
    pick = {}
    for s, c in L.TUNING:
        cands = sorted([g for g in ing if g['m']['role'] == 'tuning' and g['scenario'] == s and g['m']['attempt'] <= 3], key=lambda g: g['m']['attempt'])
        ok = [g for g in cands if good(g)]
        pick[s] = ok[0] if ok else None
    missing = [s for s, g in pick.items() if g is None]
    # Stage 8d, rule R3 (user decision 16 Nov): a scenario with 3 failed attempts (attempts 1, 2, 3 all present, none usable) gets ONE fallback flight with theta_best (manifest role 'fallback', attempt 4);
    # it is not used for the fit, the cost or theta_best; the beta fit uses the usable flights of the other scenarios; theta_l is not eligible for keep-best. Round 0 (no theta_best yet): no fallback flight.
    R3_VERSION = 'R3-2026-11-16'
    r3 = [s for s in missing if {1, 2, 3} <= {g['m']['attempt'] for g in ing if g['m']['role'] == 'tuning' and g['scenario'] == s}]
    need_more = [s for s in missing if s not in r3]
    fb = {g['scenario']: g for g in ing if g['m']['role'] == 'fallback' and g['scenario'] in r3}
    seconds_ingest = time.time() - t0
    flights = [dict(scenario=g['scenario'], file=g['m']['file'], attempt=g['m']['attempt'], role=g['m']['role'], gate_ok=g['gate']['ok'], gate_reasons=g['gate']['reasons'],
                    rows=g['gate']['rows'], rate_hz=g['gate']['rate_hz'], gap_fraction=g['gate']['gap_fraction'], frame=g.get('frame'), reference_check=g.get('reference_check'),
                    crashed=g.get('flags', {}).get('crashed'), floor=g.get('flags', {}).get('floor'), tilt_max_deg=g.get('flags', {}).get('tilt_max_deg'),
                    rms3d_cm=g.get('rms3d_cm'), used=any(g is p for p in pick.values()) and g['m']['role'] != 'fallback') for g in ing]
    rep = dict(round=l, controller=L.CTRL, phi=phi_l.tolist(), psi_before=psi.tolist(), flights=flights, missing=missing, seconds_ingest=seconds_ingest)
    keep0 = st['keep']; no_fb = [s for s in r3 if s not in fb]
    if need_more or (r3 and keep0 is not None and no_fb) or len(missing) == len(L.TUNING):
        if need_more or len(missing) == len(L.TUNING): rep['status'] = 'no usable flight for %s: repeat (attempt <= 3), nothing fitted' % missing
        else:
            rep['status'] = ('R3: %s failed all 3 attempts. Fly each of them ONCE more with theta_best = the gains of round %d (%s), add it to flights.json with role "fallback" and attempt 4 (the fallback flight is not used for the fit), then run this command again. Nothing fitted, no next round written.' % (no_fb, keep0['round'], sd / ('round_%d' % keep0['round']) / 'gains.yaml'))
        rd.mkdir(exist_ok=True); json.dump(rep, open(rd / 'report.json', 'w'), indent=1); (rd / 'report.md').write_text('# Round %d: %s\n' % (l, rep['status'])); say(rep['status'])
        return rep
    fl = [dict(cost=pick[s]['cost_m2'], z_cost=pick[s]['z_cost_m2'], crashed=False, floor=False, tries=pick[s]['m']['attempt'] - 1) for s, _ in L.TUNING if pick[s] is not None]          # Stage 8d: used flights only (all 5 unless R3)
    rc = L.round_cost(fl); rep['real'] = rc
    rep['eligible'] = not r3; rep['r3_version'] = R3_VERSION
    if r3: rep['r3'] = dict(scenarios=r3, fallback_files={s: fb[s]['m']['file'] for s in fb}, theta_best_round=None if keep0 is None else keep0['round'], note='fallback flights are not used for the fit, the cost or theta_best; this set is not eligible for keep-best')
    rep['per_scenario_cm'] = {s: (pick[s]['rms3d_cm'] if pick[s] is not None else None) for s, _ in L.TUNING}
    rep['test_cm'] = {'%s[%d]' % (g['scenario'], g['m']['cell']): g['rms3d_cm'] for g in ing if g['m']['role'] == 'test' and g.get('usable')}
    keep = st['keep']
    if not r3 and (keep is None or rc['cost'] <= keep['cost']):          # Stage 8d: a set with an R3 scenario is not eligible for keep-best
        keep = dict(cost=rc['cost'], rms3d_cm=rc['rms3d_cm'], round=l, phi=phi_l.tolist())
    rep['keep_best'] = keep; say('real 3-D RMS %.2f cm (mean of the %d usable tuning flights%s); keep-best %s' % (rc['rms3d_cm'], len(fl), ('; R3 on %s, set NOT eligible' % r3) if r3 else '', ('round %d (%.2f cm)' % (keep['round'], keep['rms3d_cm'])) if keep else 'none yet (no eligible set)'))
    x = np.r_[phi_l, psi]
    traces = {i: [pick[s]['trace']] for i, (s, _) in enumerate(L.TUNING) if pick[s] is not None}
    tops = {i: (pick[s_]['ref'].top_pos, pick[s_]['ref'].top_vel) for i, (s_, _) in enumerate(L.TUNING) if pick[s_] is not None and pick[s_]['ref'].has_top and (top == 'logged' or (top == 'auto' and s_ in TOP_FROM_LOG))}
    rep['top_path'] = {s_: ('logged' if i in tops else 'planned') for i, (s_, _) in enumerate(L.TUNING)}          # R3 scenario: planned top in the tuning step
    pool = LP.PoolTop(len(L.TUNING), states=tuple(S['states']), tops=tops)
    try:
        t1 = time.time()
        if not (last and S['skip_last_fit']):
            if r3:          # Stage 8d R3: the fit uses the usable flights of the other scenarios (equal weights over them); scenario list and tops re-indexed to that subset
                sub = [i for i in range(len(L.TUNING)) if i in traces]; tr_sub = {j: traces[i] for j, i in enumerate(sub)}; pool.tops = {j: tops[i] for j, i in enumerate(sub) if i in tops}
                fit_fn = lambda xx: pool.rollouts('sysid', xx, tr_sub, scen_list=[L.TUNING[i] for i in sub])
            else:
                fit_fn = lambda xx: pool.rollouts('sysid', xx, traces)
            x, rf = L.adam_inner(fit_fn, x, L.PSI_FIT_IDX, S['lr'], K2=S['epochs'], label='fit beta, round %d' % l, stop=False, best=not S.get('paper_stop', False), paper_stop=S.get('paper_stop', False))
            rep['fit'] = dict(epochs=rf['epochs'], J0=rf['J0'], J_best=rf['J_best'], best_epoch=rf['best_epoch'], J_end=rf.get('J_end'), reason=rf.get('reason')); say('fit beta: J0 %.4g -> %.4g (%s), epochs %d, psi %s' % (rf['J0'], rf['J_best'] if rf['J_best'] is not None else rf['J_end'], ('best epoch %d' % rf['best_epoch']) if rf['best_epoch'] is not None else 'last iterate, stop: %s' % rf['reason'], rf['epochs'], np.round(x[10:], 3).tolist()))
        pool.tops = tops
        rep['seconds_fit'] = time.time() - t1; rep['psi_after_fit'] = x[10:].tolist()
        t2 = time.time()
        if not last:
            pool.noise_seeds = tuple(S['noise_seed_base'] + S['n_noise_seeds'] * l + j for j in range(S['n_noise_seeds'])) if S.get('noise', True) else None          # Stage 8: paper = no noise in the tuning step
            x, rt = L.adam_inner(lambda xx: pool.rollouts('task', xx, None), x, np.arange(10), S['lr'], K2=S['epochs'], label='tune theta, round %d' % l, stop=False, best=not S.get('paper_stop', False), paper_stop=S.get('paper_stop', False),
                                 limit=float(np.log(1 + S['gain_limit'])) if S['gain_limit'] else None)
            rep['tune'] = dict(epochs=rt['epochs'], J0=rt['J0'], J_best=rt['J_best'], J_end=rt.get('J_end'), best_epoch=rt['best_epoch'], hits=rt['hits'], noise_seeds=(list(pool.noise_seeds) if pool.noise_seeds else None), epochs_used=rt['epochs'], reason=rt.get('reason'))
            say('tune theta: J0 %.4g -> %.4g (%s), epochs %d, gain-limit hits %s' % (rt['J0'], rt['J_best'] if rt['J_best'] is not None else rt['J_end'], ('best epoch %d' % rt['best_epoch']) if rt['best_epoch'] is not None else 'last iterate, stop: %s' % rt['reason'], rt['epochs'], rt['hits']))
        rep['seconds_tune'] = time.time() - t2
        if not last and not NO_PREVIEW:          # Stage 8b: safety preview of the new gain set in the existing pool workers (never changes theta)
            import preview as PV
            pv = PV.run(L, lambda fn, jobs: pool.pool.map(fn, jobs, chunksize=1), x[:10], x[10:], keep['phi'] if keep else [0.0] * 10)
            rep['preview'] = dict(verdict=pv['verdict'], passed=pv['passed'], fails=[list(f) for f in pv['fails']], mean_rms_cm=pv['mean_rms_cm'], seconds=pv['seconds'], notes_worse=[list(n) for n in pv['notes_worse']], text=PV.text(pv, L)); say(rep['preview']['text'])
    finally:
        pool.close()
    phi_next = x[:10]; psi_next = x[10:]
    rep.update(phi_next=None if last else phi_next.tolist(), psi_after=psi_next.tolist(), theta_factors_next=None if last else dict(zip(L.GAIN_NAMES, np.exp(phi_next - phi_l).round(4).tolist())),
               theta_factors_vs_default=dict(zip(L.GAIN_NAMES, np.exp(phi_l).round(4).tolist())), last_round=last, recommendation_if_last=(dict(theta_best_round=keep['round'] if keep else None, eligible_set=keep is not None) if last else None))
    rep['seconds_total'] = time.time() - t_start
    st_next = dict(round=l + 1, phi=phi_next.tolist(), psi=psi_next.tolist(), keep=keep, settings=S, controller=L.CTRL,
                   history=st['history'] + [dict(round=l, rms3d_cm=rc['rms3d_cm'], phi=phi_l.tolist(), psi_after_fit=rep['psi_after_fit'], **(dict(eligible=False, r3=r3) if r3 else {}))])
    rep['seed_info'] = dict(noise_seed_base=S['noise_seed_base'], note='noise seeds of the tuning step of round l: base + 2 l, base + 2 l + 1')
    rd.mkdir(exist_ok=True); json.dump(rep, open(rd / 'report.json', 'w'), indent=1)
    md = ['# Round %d report (%s, method version "A + B")' % (l, L.CTRL), '', 'Real cost (mean of the %d usable tuning flights, 3-D RMS): **%.2f cm**; keep-best: %s.' % (len(fl), rc['rms3d_cm'], ('round %d (%.2f cm)' % (keep['round'], keep['rms3d_cm'])) if keep else 'none yet (no eligible set)')] + (['', '**R3: %s failed 3 attempts; fallback flight(s) with theta_best (round %s) not used for the fit; this set is NOT eligible for keep-best.**' % (r3, keep0['round'] if keep0 else 'n/a, no theta_best yet')] if r3 else []) + ['',
          '| scenario | file | attempt | gate | crashed | floor | 3-D RMS cm | used |', '|---|---|---|---|---|---|---|---|']
    for f in flights:
        md.append('| %s | %s | %d | %s | %s | %s | %.2f | %s |' % (f['scenario'], f['file'], f['attempt'], 'ok' if f['gate_ok'] else ';'.join(f['gate_reasons']), f['crashed'], f['floor'], f['rms3d_cm'] or float('nan'), 'yes' if f['used'] else 'no'))
    md += ['', 'Test flights (not used for the update): %s' % rep['test_cm'], '', 'beta (log-factors) after the fit: %s' % np.round(psi_next, 4).tolist(),
           'theta flown (factor to the default gains): %s' % rep['theta_factors_vs_default']]
    if not last:
        md += ['theta of the next round (factor to this round): %s' % rep['theta_factors_next'], 'gain-limit hits per gain (of 51 evaluations): %s' % dict(zip(L.GAIN_NAMES, rep['tune']['hits']))]
    if 'preview' in rep: md += ['', '## Safety preview of the next gain set (frsim, fitted beta, 2 noise seeds; never changes the gains)', '', '```', rep['preview']['text'], '```']
    md += ['', 'Desk time of this command: %.0f s (ingest %.0f s, fit %.0f s, tune %.0f s).' % (rep['seconds_total'], seconds_ingest, rep['seconds_fit'], rep['seconds_tune'])]
    (rd / 'report.md').write_text('\n'.join(md) + '\n')
    if not last:
        nd = sd / ('round_%d' % (l + 1)); nd.mkdir(exist_ok=True)
        json.dump(st_next, open(nd / 'state.json', 'w'), indent=1)
        gains_to_yaml(phi_next, nd / 'gains.yaml', 'round %d: theta_%d from round %d (method version A + B, keep-best %s)' % (l + 1, l + 1, l, ('round %d' % keep['round']) if keep else 'none yet'))
        if 'preview' in rep:
            (nd / 'PREVIEW.txt').write_text(rep['preview']['text'] + '\n' + ('' if rep['preview']['passed'] else 'DO NOT FLY THIS SET WITHOUT ASKING THE USER; default action: fly the best flown set again (%s). The gains file gains.yaml is written unchanged.\n' % (('round %d' % keep['round']) if keep else 'none eligible yet: the default gains, round 0'))); json.dump(rep['preview'], open(nd / 'preview.json', 'w'), indent=1)
    else:
        json.dump(st_next, open(rd / 'state_after.json', 'w'), indent=1)
        gains_to_yaml(np.array(keep['phi'] if keep else [0.0] * 10), rd / 'gains_theta_best.yaml', ('theta_best = theta_%d (keep-best over the eligible flown gain sets)' % keep['round']) if keep else 'no eligible set: theta_0 (default gains)')
    say('round %d done in %.0f s' % (l, rep['seconds_total']))
    return rep


def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    ap.add_argument('--controller', default='S0'); ap.add_argument('--round', type=int); ap.add_argument('--logs'); ap.add_argument('--init', action='store_true')
    ap.add_argument('--state-dir', default=None); ap.add_argument('--n-rounds', type=int, default=None); ap.add_argument('--grad-mode', choices=['reverse', 'forward', 'mixed', 'mixed2', 'cfwd'], default=None)
