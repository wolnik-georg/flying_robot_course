+class Lpf2p:
+    """Second-order low-pass of the firmware (fw/src/utils/src/filter.c lpf2pSetCutoffFreq / lpf2pApply), same discrete form, float64."""
+    def __init__(self, sample_freq=GYRO_LPF_RATE_HZ, cutoff_freq=GYRO_LPF_HZ):
+        fr = sample_freq / cutoff_freq; ohm = math.tan(math.pi / fr); c = 1.0 + 2.0 * math.cos(math.pi / 4.0) * ohm + ohm * ohm
+        self.b0 = ohm * ohm / c; self.b1 = 2.0 * self.b0; self.b2 = self.b0
+        self.a1 = 2.0 * (ohm * ohm - 1.0) / c; self.a2 = (1.0 - 2.0 * math.cos(math.pi / 4.0) * ohm + ohm * ohm) / c
+        self.d1 = np.zeros(3); self.d2 = np.zeros(3)
+
+    def apply(self, sample):
+        d0 = sample - self.d1 * self.a1 - self.d2 * self.a2
+        out = d0 * self.b0 + self.d1 * self.b1 + self.d2 * self.b2
+        self.d2 = self.d1; self.d1 = d0
+        return out
+
