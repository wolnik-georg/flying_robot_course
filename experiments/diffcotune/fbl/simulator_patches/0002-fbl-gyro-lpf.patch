+GYRO_LPF_HZ, GYRO_LPF_RATE_HZ = 80.0, 1000.0   # drone sensor driver: lpf2pInit(&gyroLpf[i], 1000, 80), fbl_v2_firmware/fw/src/hal/src/sensors_bmi088_bmp3xx.c:140, :555; applied to sensorData.gyro at 1 kHz (:339)
