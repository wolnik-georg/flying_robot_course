# Crazyflie app-layer configuration — CF2.1 BRUSHLESS (CF21BL).
# Selected by: make DRONE=bl  (which also loads cf21bl_defconfig as the base config,
# setting CONFIG_PLATFORM_CF21BL, DShot ESC protocol, and motor arming).
#
# CONFIG_APP_ENABLE=n     — we do NOT use the app-layer (no appMain needed)
# CONFIG_CONTROLLER_OOT=y — routes controllerOutOfTree* calls to our Rust lib
# EXPERIMENT (2026-07-16): force-enable the optical RPM deck on the brushless too, exactly
# like the brushed app-config/app-config-std. The bcRpm driver has vid/pid=0x00 (no 1-Wire
# ID) so it NEVER auto-detects — it must be force-enabled at build time here. Without this
# the rpm.* log group stays 0 no matter what the yaml deck.bcRpm param says.
# To return to DShot telemetry: delete CONFIG_DECK_FORCE below (keep DSHOT_BIDIRECTIONAL).
CONFIG_APP_ENABLE=n
CONFIG_CONTROLLER_OOT=y
# 2026-09-14: second OOT slot -- stabilizer.controller=7, the faithful NA-INDI port.
CONFIG_CONTROLLER_OOT2=y
# 2026-09-22: third OOT slot enabled here ONLY so the enum stays contiguous and OOT4 (below)
# lands at stabilizer.controller=9 as documented, not 8. Enabling this flag does not change any
# existing flight config -- controller=8 was already a valid value before, just unused on this
# build; still NOT NUMERICALLY VERIFIED, do not select it. See LOCAL_MODIFICATIONS.md.
CONFIG_CONTROLLER_OOT3=y
# 2026-09-22: fourth OOT slot -- stabilizer.controller=9, supervisor's INDI, literal C copy of
# controller_lee.c from crazyflie-firmware-omar (see docs/41). NEVER FLOWN, do not select.
CONFIG_CONTROLLER_OOT4=y
# 2026-09-23 REVISED (was 41000, our own measured mass -- see git history for that reasoning):
# CF_MASS override -- was previously unset on this build, silently falling back to the STOCK
# 39.3g default (neither Omar's nor ours). Now set to Omar's OWN brushless-established value,
# 42700 (42.7g) -- copied verbatim from his own cf21blrpm_defconfig
# (crazyflie-firmware-omar/configs/cf21blrpm_defconfig), not our independently measured 41.0g.
# Operator decision 2026-09-23: for controller=9 (Omar's INDI, literal C port), use exactly the
# airframe constant set HE established for brushless, not a mix of his port + our own
# measurement -- consistent with MOTORRPM2FORCE/THRUST2TORQUE/ARM_LENGTH already being his
# brushless-platform values verbatim (platform_defaults_cf21bl.h, unconditional on this build).
#
# ⚠️ SCOPE CAVEAT: CONFIG_MODIFIED_CF_MASS is ONE global override shared by every controller on
# THIS build that reads CF_MASS directly (grep-confirmed: stock Lee=5, stock Mellinger=2, stock
# Brescianini=4, Omar's port=9 -- there is no way to give just one controller a different value
# at compile time without hardcoding a literal into his file, which would violate the
# byte-identical port). Safe in practice: per this project's standing convention, stock Lee only
# ever flies on cf_second (a SEPARATE standard-CF2.1 build/config, app-config-std, not this
# file) -- nothing actually flown on the brushless airframe reads CF_MASS except the
# never-flown controller=9. If stock Lee/Mellinger/Brescianini are ever deliberately selected on
# THIS (brushless) build for some other reason, this value needs reconsidering first -- it is no
# longer this project's own measured mass. Does NOT affect our own Rust controller (=6,
# controller=7/8 Rust ports either) -- all three have their own separate, unaffected mass
# constants, never CF_MASS.
CONFIG_MODIFY_CF_MASS=y
CONFIG_MODIFIED_CF_MASS=42700
CONFIG_MOTORS_ESC_PROTOCOL_DSHOT_BIDIRECTIONAL=y
CONFIG_DECK_FORCE="bcRpm"
