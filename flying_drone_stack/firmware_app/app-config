# Crazyflie app-layer configuration for the Rust out-of-tree controller.
#
# CONFIG_APP_ENABLE=n     — we do NOT use the app-layer (no appMain needed)
# CONFIG_CONTROLLER_OOT=y — routes controllerOutOfTree* calls to our Rust lib
# APP_STACKSIZE=1024      — more stack than the hello-world default (350);
#                           the SE(3) controller uses several 3×3 matrices
CONFIG_APP_ENABLE=n
CONFIG_CONTROLLER_OOT=y
# 2026-09-14: second OOT slot -- stabilizer.controller=7, the faithful NA-INDI port,
# implemented in a separate Rust module (src/naindi.rs) so it never touches the code above.
CONFIG_CONTROLLER_OOT2=y
# 2026-09-16: third OOT slot -- stabilizer.controller=8, the SAME reference file as OOT2 but
# with use_nn enabled (true NA-INDI), implemented in src/naindi_hybrid.rs, no shared state with
# either controller above. Enabling this flag only makes controller=8 a VALID, selectable enum
# value -- it does not change what any existing flight runs, since that is still chosen at
# runtime via stabilizer.controller (crazyflies.yaml), unaffected by this. NOT YET NUMERICALLY
# VERIFIED against the reference's own compiled C -- do not select controller=8 in flight until
# it is. See firmware_app/host/LOCAL_MODIFICATIONS.md.
CONFIG_CONTROLLER_OOT3=y
CONFIG_DECK_FORCE="bcRpm"
# Drone has the Bitcraze thrust upgrade kit (upgraded motors + props).
# Selects the matching mixer thrust model: THRUST_MAX 0.18 N (was 0.12),
# THRUST2TORQUE 0.00516 (was 0.00699), and the kit's VMOTOR2THRUST curve.
# Without this the mixer under-estimates thrust by ~1.5x (0.18/0.12) -> 31 cm
# hover offset, 1.5x effective attitude gain, and INDI increment mismatch.
CONFIG_CRAZYFLIE_THRUST_UPGRADE_KIT=y
