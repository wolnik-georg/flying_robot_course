# Rust build artifacts
target/

# Firmware build output
firmware_app/build/
firmware_app/app.o
firmware_app/built-in.o
firmware_app/traj_iface.o
firmware_app/target/

# Flight CSVs and results (large binary/data files)
results/

# Python virtualenv
.venv/

# Python cache
__pycache__/
*.pyc

# Markdown: track it all, except files that are explicitly personal scratch.
#
# This used to be a blanket `*.md` ignore with a hand-maintained allowlist. It silently hid 14
# files -- the entire INDI oscillation investigation, the inverted-loop investigation, GLOSSARY,
# paper_summaries, the uSD logging README, LOCAL_MODIFICATIONS -- and every new document written
# here was invisible to git unless someone remembered to add an exception. Ignore by name, not by
# extension.
#
# Note: CLAUDE.md files are excluded separately and deliberately by the ROOT .gitignore
# (`**/CLAUDE.md`). Nothing here changes that.
STUDY_QA_LOCAL.md

# Build artefacts from the out-of-tree firmware build. `.o.d` files are gcc dependency lists
# full of absolute machine paths, so they churn on every build and mean nothing in a clone.
firmware_app/*.o
firmware_app/.*.o.d
