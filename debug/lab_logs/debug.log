# cf_second height-sweep isolation test — 2026-09-14
#
# Why: cf_second showed a consistent ~0.35-0.4m height SHORTFALL (commanded vs achieved),
# seen twice independently -- isolated flight.py hover (1.4m commanded -> 1.03m achieved)
# and tonight's A8 run (1.25m commanded -> 0.86m achieved, self-reported |ez|=244mm by
# run_formation.py's own realised-geometry check). Mocap ceiling ruled out (1.5-1.7m
# clearance). Battery voltage ruled out (cf_second's vbat was comparable to cf231_active's,
# if anything higher on average). This test isolates cf_second alone across 3 heights to see
# whether the shortfall is a FIXED offset (mass/thrust miscalibration in stock Lee) or GROWS
# with height (PID/integrator saturation).
#
# crazyflies.yaml already pushed with cf231_active disabled again for this test --
# `git pull` picks that up. Restart terminal 1's `ros2 launch crazyflie launch.py` after
# pulling so it re-reads the yaml.

# ── 1. Environment (same as before) ──────────────────────────────────────────────────────
source /opt/ros/jazzy/setup.bash
source /home/flyingrobots/venv/bin/activate
cd /home/flyingrobots/georg/ros2_ws
git -C src/crazyswarm2 pull
git -C src/flying_robot_course pull  # picks up this debug.log, harmless if unused here
colcon build --symlink-install --packages-select crazyflie_examples crazyflie
. install/local_setup.bash

# ── 2. Restart terminal 1 (crazyflie launch) so it re-reads crazyflies.yaml ──────────────
# Ctrl+C the running `ros2 launch crazyflie launch.py`, then:
ros2 launch crazyflie launch.py

# ── 3. Sanity check cf_second is the only one enabled ────────────────────────────────────
grep -A2 "cf231_active:" /home/flyingrobots/georg/ros2_ws/src/crazyswarm2/crazyflie/config/crazyflies.yaml | grep "enabled: false"
# should print a match -- if empty, the pull/restart didn't take, stop and re-check.

# ── 4. Three-point height sweep, terminal 2 (source step 1 there too) ────────────────────
# Run all three back to back, same session, same battery -- don't swap batteries mid-sweep,
# that would reintroduce the voltage variable we're trying to rule out.
ros2 run crazyflie_examples flight -- --trajectory hover --duration 15 --height 0.6
ros2 run crazyflie_examples flight -- --trajectory hover --duration 15 --height 0.9
ros2 run crazyflie_examples flight -- --trajectory hover --duration 15 --height 1.25

# ── 5. What to look for in each log's steady-state z (last ~5s before landing starts) ────
# Compare achieved vs commanded for each of the 3 runs:
#   ~0.35-0.4m short at ALL three heights  -> fixed offset (mass/thrust calibration in the
#                                             stock Lee firmware doesn't match this drone's
#                                             actual physical mass/prop thrust)
#   shortfall grows with commanded height  -> PID/integrator saturation, not a flat offset
#   shortfall ~0 at low heights, appears only near 1.2-1.25m -> possible thrust-saturation
#                                             ceiling specific to this airframe/battery combo
#
# Logs land in Controls/logs/hover_mode0_<timestamp>.csv (flight.py's own LOGS_DIR) in the
# flying_robot_course checkout -- git add/commit/push those 3 CSVs from there so I can
# analyze them, same as before.

# ── After the sweep: re-enable cf231_active before any further 2-drone flight ────────────
# (crazyflies.yaml robots.cf231_active.enabled: false -> true, on the DEV machine, then
# git push + you git pull on the lab PC again -- same loop as before.)
