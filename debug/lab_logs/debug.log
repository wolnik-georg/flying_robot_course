# ── Run on the LAB PC. Paste the whole block. ──────────────────────────────
LOG=~/georg/flying_robot_course/debug/lab_logs/debug.log
exec > >(tee "$LOG") 2>&1

echo "########## 1. LOCATE CHECKOUTS ##########"
ls -d ~/georg/ros2_ws 2>/dev/null
find ~/georg ~/ -maxdepth 4 -name "crazyswarm2" -type d 2>/dev/null | head
find ~/ -maxdepth 5 -name "motion_capture*.yaml*" 2>/dev/null

echo "########## 2. SOURCE vs INSTALLED (the key comparison) ##########"
SRC=$(find ~/georg -maxdepth 4 -type d -name crazyswarm2 2>/dev/null | head -1)
echo "SRC=$SRC"
echo "--- SOURCE default_single_marker ---"
grep -A14 "marker_configurations" "$SRC/crazyflie/config/motion_capture.yaml"
echo "--- INSTALLED default_single_marker (best hope: may still hold the 4 points) ---"
grep -A14 "marker_configurations" ~/georg/ros2_ws/install/crazyflie/share/crazyflie/config/motion_capture.yaml
echo "--- BUILD dir copy, if any ---"
find ~/georg/ros2_ws/build -name "motion_capture.yaml" -exec echo {} \; -exec grep -A14 "marker_configurations" {} \; 2>/dev/null

echo "########## 3. FILE TIMESTAMPS (shows what was overwritten and when) ##########"
ls -la --time-style=full-iso "$SRC/crazyflie/config/motion_capture.yaml" \
  ~/georg/ros2_ws/install/crazyflie/share/crazyflie/config/motion_capture.yaml \
  "$SRC/crazyflie/config/crazyflies.yaml" 2>/dev/null

echo "########## 4. GIT RECOVERY SOURCES ##########"
cd "$SRC" || exit
echo "--- status ---";      git status
echo "--- local diff ---";  git diff -- crazyflie/config/
echo "--- stash list ---";  git stash list
echo "--- reflog ---";      git reflog | head -40
echo "--- dangling blobs/commits (wiped work often survives here) ---"
git fsck --lost-found --dangling 2>/dev/null | head -30

echo "########## 5. SEARCH ALL DANGLING OBJECTS FOR THE 4-POINT CONFIG ##########"
for o in $(git fsck --lost-found --dangling 2>/dev/null | awk '{print $3}'); do
  if git cat-file -p "$o" 2>/dev/null | grep -q "default_single_marker\|marker_configurations"; then
    echo "=== FOUND in object $o ==="; git cat-file -p "$o" | grep -B3 -A14 "marker_configurations"
  fi
done

echo "########## 6. EDITOR / SYSTEM BACKUPS ##########"
ls -la "$SRC/crazyflie/config/" | grep -i "bak\|orig\|~\|swp\|save"
find ~/ -maxdepth 6 \( -name "*motion_capture*~" -o -name "*motion_capture*.bak" -o -name "*motion_capture*.orig" \) 2>/dev/null | head

echo "########## 7. ACTIVE MARKER IDs CURRENTLY ON THE DRONES ##########"
grep -n "activeMarker\|bcActiveMarker" ~/georg/ros2_ws/install/crazyflie/share/crazyflie/config/crazyflies.yaml
echo "(empty above = no per-drone marker IDs are being set at all)"

echo "########## DONE ##########"